# Model providers. Never commit real keys.
META_API_KEY=
BASETEN_API_KEY=
# meta (default) or baseten (open-weights bonus path).
ECHO_MODEL_PROVIDER=meta
# Optional overrides: BASETEN_BASE_URL defaults to https://inference.baseten.co/v1,
# BASETEN_MODEL_ID defaults to meta-models/muse-spark-open-1026.
# BASETEN_BASE_URL=
# BASETEN_MODEL_ID=

# Local daemon development port.
ECHO_PORT=4783
